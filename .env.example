# ==============================================================================
# NEBULA - ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO (.env.example)
# ==============================================================================

# ── BANCO DE DADOS (PostgreSQL) ──────────────────────────────────────────────
# Utilizado pela API (Prisma) e pelo Worker (asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=nebula_db
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:sua_senha_aqui@localhost:5432/nebula_db"

# ── CACHE E FILAS (Redis) ─────────────────────────────────────────────────────
# Utilizado para BullMQ (API) e processamento de jobs (Worker)
REDIS_URL="redis://localhost:6379"

# ── STORAGE (MinIO / S3) ──────────────────────────────────────────────────────
# Configurações de acesso ao bucket de áudios
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=sua_senha_minio
MINIO_ACCESS_KEY=seu_access_key
MINIO_SECRET_KEY=seu_secret_key
MINIO_BUCKET=transcriber
MINIO_SECURE=false

# Endpoints: Public é usado pelo navegador (presigned URLs), Internal pela API/Worker
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ENDPOINT=localhost:9000

# Webhook para notificações de upload do MinIO para a API
MINIO_WEBHOOK_SECRET=sua_chave_secreta_webhook

# ── API CORE (Node.js/Fastify) ────────────────────────────────────────────────
PORT=3333
NODE_ENV=development
REGISTRATION_ENABLED=true  # Define se novos usuários podem se cadastrar
LOG_LEVEL=info

# Segurança de Sessão (API)
# SESSION_SECRET deve ter no mínimo 32 caracteres
SESSION_SECRET=coloque_uma_string_muito_longa_e_aleatoria_aqui
# SESSION_SALT deve ter exatamente 16 caracteres
SESSION_SALT=salt_com_16_char

# Caminho para os arquivos de prompt (.txt)
# ── INTELIGÊNCIA ARTIFICIAL (LLM & Embeddings) ──────────────────────────────
# Provedores de modelos para sumarização e Q&A
GROQ_API_KEY=sua_chave_groq_aqui
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=groq/compound-mini
EMBEDDING_MODEL=mxbai-embed-large

# ── TRANSCRIPTION WORKER (Python/Parakeet) ───────────────────────────────────
# Configurações de segmentação fonética e performance do worker
UPLOAD_MAX_CHUNK_SEC=55.0  # Limite de áudio por chamada ao encoder (evita OOM)
UPLOAD_OVERLAP_SEC=2.0     # Segundos de contexto entre fatias de áudio
UPLOAD_SILENCE_DB=-35.0    # Sensibilidade para detectar silêncio (cortes)
UPLOAD_SILENCE_MIN=0.3     # Tempo mínimo de silêncio para permitir corte
UPLOAD_CONCURRENCY=2       # Quantidade de transcrições paralelas por worker
MODELS_DIR=./apps/parakeet_worker/models

# Gaps de tempo para considerar novo parágrafo (em segundos)
PARAGRAPH_GAP_MEETING=1.2
PARAGRAPH_GAP_CLASS=2.0

# ── FRONTEND (Web/Vite) ──────────────────────────────────────────────────────
# URL base que o navegador usará para falar com a API
VITE_API_BASE_URL=http://localhost:3333

# Optional batch speaker diarization (rebuild worker images when enabling).
DIARIZATION_ENABLED=false
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
