# ── Worker (faster-whisper) — variáveis de ambiente ──────────────────────────
# Copie para .env e ajuste conforme seu ambiente.

# ── gRPC ──────────────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_WORKERS=4
GRPC_MAX_RECV_MB=16

# ── Modelo ────────────────────────────────────────────────────────────────────
# HuggingFace repo com modelo CTranslate2 já convertido
MODEL_PATH=deepdml/whisper-large-v3-turbo-ct2
# "cuda" para GPU, "cpu" para desenvolvimento sem GPU
MODEL_DEVICE=cuda
# "float16" ou "bfloat16" para RTX 4060. "int8" para CPU dev.
COMPUTE_TYPE=float16
CPU_THREADS=4

# ── Sessão / VRAM ─────────────────────────────────────────────────────────────
MAX_SESSIONS=8
SESSION_TIMEOUT_SEC=30.0
# VRAM mínima livre (MB) para aceitar nova sessão
VRAM_MIN_FREE_MB=512

# ── Batch ─────────────────────────────────────────────────────────────────────
# Manter em 1: batch é baixa prioridade, semáforo já protege VRAM
BATCH_CONCURRENCY=1

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://transcriber:transcriber@localhost:5432/transcriber

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=transcriber
MINIO_SECURE=false

# ── Filas ─────────────────────────────────────────────────────────────────────
QUEUE_POST_PROCESSING=post-processing

# ── Parâmetros de parágrafo ───────────────────────────────────────────────────
PARAGRAPH_GAP_MEETING=1.2
PARAGRAPH_GAP_CLASS=2.0

# ── Observabilidade ───────────────────────────────────────────────────────────
METRICS_PORT=9090
# Vazio = tracing desabilitado
OTEL_ENDPOINT=
LOG_LEVEL=INFO
LOG_FORMAT=text
