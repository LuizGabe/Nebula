{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "proto:generate": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --keepCase --grpcLib=@grpc/grpc-js --outDir=src/proto/generated src/proto/transcriber.proto",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "fastify",
    "api",
    "framework"
  ],
  "author": "LuizGabe",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/ws": "^8.18.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.1",
    "docx": "^9.13.0",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "fastify-sse-v2": "^4.2.2",
    "groq-sdk": "^1.1.2",
    "ioredis": "^5.10.1",
    "pdfkit": "^0.20.2",
    "pino-pretty": "^13.1.3",
    "redis": "^5.11.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.7",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
