// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AudioMediaSource {
  STREAM
  UPLOAD
}

enum AudioMediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  TRANSCRIBED
  FAILED
}

enum DocumentType {
  MEETING_MINUTES
  CLASS_NOTES
}

enum SessionEventType {
  // Fluxo de chunk (streaming)
  CHUNK_RECEIVED
  CHUNK_QUEUED
  CHUNK_TRANSCRIPTION_STARTED
  CHUNK_TRANSCRIBED
  CHUNK_FAILED
  

  // Fluxo de upload completo
  UPLOAD_RECEIVED
  UPLOAD_QUEUED
  UPLOAD_TRANSCRIPTION_STARTED
  UPLOAD_TRANSCRIBED
  UPLOAD_FAILED

  // Pós-processamento (LLM)
  DOCUMENT_QUEUED
  DOCUMENT_GENERATING
  DOCUMENT_READY
  DOCUMENT_SKIPPED
  DOCUMENT_FAILED
}

enum RecordingMode {
  MEETING
  CLASS
}

enum RecordingSessionStatus {
  ACTIVE
  IN_PROGRESS
  ENDED
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  hashedPassword String
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions RecordingSession[]

  @@map("users")
}

model Document {
  id        String       @id @default(uuid())
  type      DocumentType
  content   String
  version   Int          @default(1)
  modelUsed String
  createdAt DateTime     @default(now())

  sessionId String
  session   RecordingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, version])
  @@map("documents")
}

model RecordingSession {
  id        String                 @id @default(cuid())
  mode      RecordingMode
  status    RecordingSessionStatus @default(ACTIVE)
  title     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  endedAt   DateTime?
  isDeleted Boolean                @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  transcripts   Transcript[]
  audioMedias   AudioMedia[]
  documents     Document[]
  sessionEvents SessionEvent[]

  @@map("recording_sessions")
}

model AudioMedia {
  id         String           @id @default(cuid())
  storageKey String
  source     AudioMediaSource
  status     AudioMediaStatus @default(PENDING_UPLOAD)

  chunkIndex     Int?
  timestampStart BigInt?
  timestampEnd   BigInt?

  createdAt DateTime @default(now())

  sessionId String
  session   RecordingSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, chunkIndex])
  @@index([sessionId, status])
  @@map("audio_chunks")
}

model Transcript {
  id             String   @id @default(cuid())
  chunkIndex     Int
  text           String
  timestampStart Float
  timestampEnd   Float
  createdAt      DateTime @default(now())

  sessionId String
  session   RecordingSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, chunkIndex])
  @@map("transcripts")
}

// ── Pipeline de Eventos ───────────────────────────────────────────────────────

/// Trilha de auditoria imutável de cada etapa do pipeline.
/// Alimenta o SSE de status e o histórico persistente.
model SessionEvent {
  id        String           @id @default(cuid())
  type      SessionEventType
  /// Dados extras: chunkIndex, erro, versão do documento, etc.
  payload   Json?
  createdAt DateTime         @default(now())

  sessionId String
  session   RecordingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("session_events")
}
