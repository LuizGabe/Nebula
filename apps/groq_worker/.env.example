# Nebula Groq Worker - exemplo local
# Copie para .env e ajuste apenas o que for necessario.

# Groq
GROQ_API_KEY=gsk_coloque_sua_chave_groq_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SEC=120

# Preparacao do audio enviado para a Groq
# O worker valida a extensao original e garante saida <= 19.5MB.
GROQ_MAX_FILE_MB=19.5
GROQ_AUDIO_TARGET_FORMAT=wav
GROQ_AUDIO_SPEED=1.08
FFMPEG_TIMEOUT_SEC=300

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=nebula_db
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/nebula_db

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_TRANSCRIPTION_JOBS=transcription-jobs
QUEUE_POST_PROCESSING=post-processing
BATCH_CONCURRENCY=1

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=seu_access_key
MINIO_SECRET_KEY=seu_secret_key
MINIO_BUCKET=transcriber
MINIO_SECURE=false

# Observabilidade
METRICS_PORT=9091
OTEL_ENDPOINT=
LOG_LEVEL=INFO
LOG_FORMAT=text
